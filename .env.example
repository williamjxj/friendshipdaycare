# ---------------------------------------------------------------------------
# Required for the site to build and run fully
# ---------------------------------------------------------------------------

# Resend (tour + contact form email delivery)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
# Verified sender address used as the From: header
RESEND_FROM_EMAIL=your_verified_sender@example.com

# Cloudflare R2 image storage
# Validated by src/lib/env.ts — the app throws if any of these are missing.
NEXT_PUBLIC_R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name

# Google Places (server-side only) — used by /api/maps
# Enable the Places API on the key.
GOOGLE_API_KEY=your_google_api_key_here

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# CDN / public URL override for R2 assets (https, no trailing slash)
NEXT_PUBLIC_R2_CDN_URL=
NEXT_PUBLIC_R2_PUBLIC_URL=

# UI/SEO Integrations (optional)
# Tour booking - Calendly or LineLeader
NEXT_PUBLIC_CALENDLY_URL=
# WhatsApp chat button - E.164 format (e.g. 16049458504)
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hi, I'm interested in learning more about Friendship Corner Daycare.
# Live chat widget (alternative to WhatsApp)
NEXT_PUBLIC_TIDIO_ID=
# Google Reviews - Place ID from Google Business
NEXT_PUBLIC_GOOGLE_PLACE_ID=
# Parent portal (e.g. Lillio/HiMama)
NEXT_PUBLIC_PARENT_PORTAL_URL=
